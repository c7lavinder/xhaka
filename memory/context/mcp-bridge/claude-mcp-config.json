      "command": "python",
      "args": ["smart-connections-mcp/server.py"],
      "env": {
        "OBSIDIAN_VAULT_PATH": "/Users/wholesaleai/.openclaw/workspace"
      }
    },
    "qmd": {
      "command": "qmd",
      "args": ["mcp"],
